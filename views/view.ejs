<%- include('partials/header') %>

<div class="form-box">
  <h1><%= entry.label %></h1>
  <p><strong>Username:</strong> <%= entry.username || 'none' %></p>
  <p><strong>Saved on:</strong> <%= entry.dateCreated.toLocaleDateString() %></p>
  <p><strong>Encrypted password:</strong></p>
  <p class="code"><%= entry.encryptedPassword %></p>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (password) { %>
    <p><strong>Decrypted password:</strong></p>
    <p class="decrypted"><%= password %></p>
  <% } else { %>
    <form action="/passwords/<%= entry.id %>/decrypt" method="POST">
      <label for="masterKey">Enter your master key to decrypt</label>
      <input type="password" id="masterKey" name="masterKey" required>
      <button type="submit" class="btn">Decrypt</button>
    </form>
  <% } %>

  <p><a href="/passwords/<%= entry.id %>/edit">Edit</a> | <a href="/passwords">Back</a></p>
</div>

<%- include('partials/footer') %>
