<%- include('partials/header') %>

<h1>My Passwords</h1>
<p>Hi <%= user.name %>! <a href="/passwords/add" class="btn">+ Add Password</a></p>

<% if (entries.length === 0) { %>
  <p>You don't have any saved passwords yet.</p>
<% } else { %>
  <table>
    <tr>
      <th>Label</th>
      <th>Username</th>
      <th>Encrypted Password</th>
      <th></th>
    </tr>
    <% entries.forEach((entry) => { %>
      <tr>
        <td><%= entry.label %></td>
        <td><%= entry.username %></td>
        <td class="code"><%= entry.encryptedPassword.slice(0, 30) %>...</td>
        <td><a href="/passwords/<%= entry.id %>">View</a> | <a href="/passwords/<%= entry.id %>/edit">Edit</a></td>
      </tr>
    <% }) %>
  </table>
<% } %>

<h2>My Activity</h2>
<% if (logs.length === 0) { %>
  <p>No activity yet.</p>
<% } else { %>
  <table>
    <tr>
      <th>Action</th>
      <th>Result</th>
      <th>Time</th>
    </tr>
    <% logs.forEach((log) => { %>
      <tr>
        <td><%= log.action %></td>
        <td class="<%= log.success ? 'success' : 'failed' %>"><%= log.success ? 'Success' : 'Failed' %></td>
        <td><%= log.timestamp.toLocaleString() %></td>
      </tr>
    <% }) %>
  </table>
<% } %>

<%- include('partials/footer') %>
